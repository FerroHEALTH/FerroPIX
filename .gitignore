# Cargo's build tree.
/target

# Backup files rustfmt writes.
**/*.rs.bk

# Claude Code personal overrides and agent worktrees, never committed.
.claude/settings.local.json
.claude/worktrees/

# Finder metadata.
.DS_Store

# IDE metadata.
.idea/

# Vendored texts whose licence keeps them out of the tree, fetched by
# scripts/vendor/*.sh for a local read (.claude/rules/vendored-inputs.md).
/.vendor-cache/

# The book's local build output and the assembled site
# (scripts/site/assemble.sh).
/website/book/book/
/_site/
